# Every variable this project reads, with dummy values. Safe to publish.
# Copy to .env.local (never committed) and fill in your own.

# ---- server only (no NEXT_PUBLIC prefix) ----
# Signs the session cookie. 32+ random characters:  openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-long-random-string-xxxxxxxx
DATABASE_URL=postgres://user:pass@localhost:5432/addis
TELEBIRR_SECRET=sk_test_replace_me

# Day 46 (both server-only): demo orders for the dashboard, and ?demo=slow|error|empty to force each state.
# Keep both false in production. To use the demos against `npm run build && npm run start`,
# set ENABLE_STATE_DEMOS=true in .env.local (it overrides .env.production).
SEED_DEMO_DATA=true
ENABLE_STATE_DEMOS=true

# ---- public: compiled into the browser bundle, readable by anyone ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_SRC=
