# Committed production defaults. Still nothing secret: real secrets live in the hosting platform's settings.
# metadataBase, canonical URLs, og:image and the sitemap are all built from this. A wrong value here
# (or localhost) is the classic "the link preview works locally but not live". Use YOUR real domain.
NEXT_PUBLIC_SITE_URL=https://addiseats.et

# Day 46: never on in production by default. A stranger must not be able to throw errors on your live site
# with ?demo=error, and the demo orders are not real. Set SEED_DEMO_DATA=true in the platform's settings for a demo deployment.
SEED_DEMO_DATA=false
ENABLE_STATE_DEMOS=false
