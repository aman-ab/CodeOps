# Copy this file to .env.local for development, and set the same
# variables in your hosting dashboard (Vercel / Render / etc.) for production.

# REQUIRED in production. Used to sign the login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Your public site URL (used for link previews / SEO). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show the demo accounts on the sign-in page? Set to "false" once you go live.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
