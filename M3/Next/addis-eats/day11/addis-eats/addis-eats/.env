# Committed defaults for everyone. Nothing secret in here, ever.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Day 46: fake orders so the dashboard has something to chart, and ?demo=slow|error|empty to force each state.
# Server-only (no NEXT_PUBLIC): neither is ever sent to the browser.
SEED_DEMO_DATA=true
ENABLE_STATE_DEMOS=true

# Optional third-party analytics tag. Leave empty for none.
NEXT_PUBLIC_ANALYTICS_SRC=
